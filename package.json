{
  "name": "affordability-explorer",
  "homepage": "http://onsdigital.github.io/affordability-explorer",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node ./scripts/js-fix",
    "build:preview": "cross-env PUBLIC_APP_ENV=preview vite build",
    "package": "vite package",
    "preview": "vite preview",
    "deploy": "gh-pages -d build -t",
    "generate-data": "node scripts/process-by-property-type.js && node scripts/calculate-affordability-by-type.js && node scripts/generate-final-files.js",
    "lint": "prettier --ignore-path .gitignore --check --plugin-search-dir=. .",
    "format": "prettier --ignore-path .gitignore --write --plugin-search-dir=. ."
  },
  "author": "Ahmad Barclay",
  "license": "MIT",
  "devDependencies": {
    "@onsvisual/svelte-charts": "^0.4.11",
    "@onsvisual/svelte-components": "^1.1.29",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "cross-env": "^7.0.3",
    "gh-pages": "^6.3.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.2.6",
    "svelte": "^5.55.8",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@onsvisual/svelte-maps": "^1.2.29",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "simple-statistics": "^7.10.2",
    "sirv-cli": "^1.0.0",
    "topojson-client": "^3.1.0",
    "xlsx": "^0.18.5"
  },
  "type": "module"
}
